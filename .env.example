# FTP login for the Hetzner web hosting behind diffusionlab.de, used by deploy.sh.
# Copy to .env (ignored by git) and fill in; the values are in konsoleH.
DEPLOY_HOST=www66.your-server.de
DEPLOY_USER=
DEPLOY_PASSWORD=
# Web folder of the site, relative to the FTP login directory
DEPLOY_PATH=public_html
