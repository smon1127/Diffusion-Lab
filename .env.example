# FTP login for the Hetzner web hosting behind diffusionlab.de, used by deploy.sh.
# Copy to .env (ignored by git) and fill in; the values are in konsoleH.
DEPLOY_HOST=www66.your-server.de
DEPLOY_USER=
DEPLOY_PASSWORD=
# Web folder of the site, relative to the FTP login directory
DEPLOY_PATH=public_html
# On-demand RunPod GPU backend (api/runpod.php); written to api/.secrets/runpod.json
# on deploy, never into the page. Leave RUNPOD_API_KEY empty to keep the live settings.
# The API key needs pod create/read/delete. RUNPOD_TOKEN_SECRET: openssl rand -hex 32;
# the pod template gets the same value as a RunPod secret.
RUNPOD_API_KEY=
RUNPOD_TOKEN_SECRET=
RUNPOD_TEMPLATE_ID=
# Pod image release, e.g. ghcr.io/<owner>/diffusionlab-pod:sha-1234567 (see the pod-image workflow)
RUNPOD_IMAGE=
# GPU types tried in order, comma-separated (keep the quotes: .env is read by bash)
RUNPOD_GPU_IDS="NVIDIA GeForce RTX 4090,NVIDIA GeForce RTX 5090"
RUNPOD_DATA_CENTER_IDS=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_MAX_SESSION_MINUTES=60
